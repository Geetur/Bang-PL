# Bang Grammar v0.1 — current implemented syntax
# This EBNF matches the current lexer, expression parser (shunting-yard), control-flow parser,
# semantic analysis, and evaluator.

# ---------------------------------------------------------------------
# 0) Lexical Tokens (from the lexer)
# ---------------------------------------------------------------------

# Single-character operators
PLUS            = "+"
MINUS           = "-"
ASTERISK        = "*"
SLASH           = "/"
ASSIGN          = "="
NEGATE          = "!"

# Grouping & punctuation
LPAREN          = "("
RPAREN          = ")"
LBRACE          = "{"
RBRACE          = "}"
LBRACKET        = "["
RBRACKET        = "]"
COMMA           = ","
SEMICOLON       = ";"
DOT             = "."   # member access
COLON           = ":"   # slice separator

# Double-character operators
PLUS_ASSIGN     = "+="
MINUS_ASSIGN    = "-="
ASTERISK_ASSIGN = "*="
SLASH_ASSIGN    = "/="
EQ              = "=="
NEQ             = "!="
LT              = "<"
LEQ             = "<="
GT              = ">"
GTEQ            = ">="
DSLASH          = "//"  # floor division
EXPO            = "**"  # exponent
AND             = "&&"
OR              = "||"

# Keywords and special tokens
KW_IF       = "if"
KW_ELIF     = "elif"
KW_ELSE     = "else"
KW_FOR      = "for"
KW_WHILE    = "while"
KW_BREAK    = "break"
KW_CONTINUE = "continue"
KW_RETURN   = "return"
KW_END      = "end"
KW_FN       = "fn"
KW_DATA     = "data"
IN          = "in"      # treated as an operator token by the lexer

# Literals & identifiers
NONE_LIT    = "none"
BOOL_LIT    = "true" | "false"
# Floats allowed as:  D* "." D+   |  D+ "." D*  (but not bare ".")
# e.g. ".5", "5.", "5.0" are valid; "." alone is the DOT token.
FLOAT_LIT   = DIGITS? DOT DIGITS | DIGITS DOT DIGITS?
INT_LIT     = DIGITS
STRING_LIT  = '"' { StringCharacter | Escape } '"'
FSTRING_LIT = 'f"' { FStringCharacter | Escape | "{{" | "}}" | Interpolation } '"'
Escape      = "\\" ( "n" | "r" | "t" | "b" | "f" | "v" | '"' | "'" | "\\" )
Interpolation = "{" Expression "}"
# StringCharacter excludes double quote, backslash, raw CR/LF, and NUL.
# FStringCharacter additionally excludes braces. Fields balance all grouping
# delimiters and can contain nested quoted/interpolated strings. Unknown escapes,
# empty fields, field comments, raw newlines, conversions, and format specs fail.
IDENT       = ( "_" | LETTER ) { "_" | LETTER | DIGIT }

# ---------------------------------------------------------------------
# 1) Program structure
# ---------------------------------------------------------------------

Separator      ::= SEMICOLON | NEWLINE ;
Separators     ::= Separator { Separator } ;
Program        ::= Block [ Statement ] ;
Block          ::= { Separator | Statement Separators } ;

# Outside balanced expression groups, newlines and semicolons separate statements.
# Inside {}, [], and (), newlines continue expressions; semicolons are rejected.
# The last statement may end at EOF.
# Each if/for/while/fn opens one block. elif/else switch branches within that if.
# "return" is only valid inside a function; "break"/"continue" only inside loops.

Statement      ::= AssignmentStmt
                 | DataClassStmt
                 | FunctionStmt
                 | IfStmt
                 | ForStmt
                 | WhileStmt
                 | BreakStmt
                 | ContinueStmt
                 | ReturnStmt
                 | ExpressionStmt ;

FunctionStmt   ::= FunctionHeader ( Separators Block KW_END | KW_RETURN Expression ) ;
AnonymousFunction ::= KW_FN FunctionInterface KW_RETURN Expression ;
IfStmt         ::= IfHeader Separators Block
                   { ElifHeader Separators Block }
                   [ ElseHeader Separators Block ] KW_END ;
ForStmt        ::= ForHeader Separators Block KW_END ;
WhileStmt      ::= WhileHeader Separators Block KW_END ;

# ---------------------------------------------------------------------
# 2) Block and branch headers
# ---------------------------------------------------------------------

# The identifier form receives a variadic argument array. The brace form binds
# declared parameters. Required parameters precede defaults; names are unique.
FunctionHeader ::= KW_FN IDENT FunctionInterface ;
FunctionInterface ::= IDENT [ ParameterOptions ] | ParameterOptions ;
# At statement level fn consumes a name; in expression position it does not.
# A short body ends at its enclosing expression boundary and has no end.
# An identifier in an anonymous interface names the positional argument array.
ParameterOptions ::= LBRACE [ ParameterList ] RBRACE ;
ParameterList  ::= Parameter { COMMA Parameter } [ COMMA ] ;
Parameter      ::= IDENT [ ASSIGN Expression ] ;
# With an argument-array name, every positional value enters that array and
# parameters in braces bind only named options. Without it they bind positionally
# or by name. The array name cannot be repeated in the declared parameter list.

IfHeader       ::= KW_IF Expression ;
ElifHeader     ::= KW_ELIF Expression ;
ElseHeader     ::= KW_ELSE ;
WhileHeader    ::= KW_WHILE Expression ;

# For header: "for <var> <iterable-expr>"
# Examples:
#   for i 10           # iterate 0 through 9
#   for x arr          # iterate elements of arr
ForHeader      ::= KW_FOR ( IDENT | Destructure ) Expression ;

# ---------------------------------------------------------------------
# 3) Single-token statements
# ---------------------------------------------------------------------

BreakStmt      ::= KW_BREAK ;
ContinueStmt   ::= KW_CONTINUE ;

ReturnStmt     ::= KW_RETURN Expression ;

# Dataclass declaration:  data Point [x, y, z]
DataClassStmt  ::= KW_DATA IDENT LBRACKET [ IdentList ] RBRACKET ;

ExpressionStmt ::= Expression ;

IdentList      ::= IDENT { COMMA IDENT } ;

# ---------------------------------------------------------------------
# 4) Expressions
# ---------------------------------------------------------------------

# Assignment is parsed specially by the expression parser.
# Left-hand side may be:
#   - IDENT
#   - IndexExpr
#   - FieldExpr
#   - Destructure (nested lists of assignable targets)
# Compound assignments (+=, -=, *=, /=) are also supported.
Expression     ::= OrExpr ;

# Assignments are statements: nested and chained assignments are rejected.
AssignmentStmt ::= Assignable AssignOp Expression ;

Assignable     ::= IDENT
                 | IndexExpr
                 | FieldExpr
                 | Destructure ;

Destructure    ::= LBRACKET [ TargetList ] RBRACKET ;
TargetList     ::= Assignable { COMMA Assignable } [ COMMA ] ;

AssignOp       ::= ASSIGN | PLUS_ASSIGN | MINUS_ASSIGN | ASTERISK_ASSIGN | SLASH_ASSIGN ;

# Short-circuit logic
OrExpr         ::= AndExpr { OR AndExpr } ;
AndExpr        ::= EqualityExpr { AND EqualityExpr } ;

# Equality / membership
EqualityExpr   ::= RelExpr { ( EQ | NEQ | IN ) RelExpr } ;

# Relational
RelExpr        ::= AddExpr { ( LT | LEQ | GT | GTEQ ) AddExpr } ;

# Additive
AddExpr        ::= MulExpr { ( PLUS | MINUS ) MulExpr } ;

# Multiplicative (including floor division)
MulExpr        ::= ExponentExpr { ( ASTERISK | SLASH | DSLASH ) ExponentExpr } ;

# Exponentiation (right-associative)
ExponentExpr   ::= UnaryExpr { EXPO ExponentExpr } ;

# Unary
UnaryExpr      ::= ( NEGATE | PLUS | MINUS ) UnaryExpr
                 | PostfixExpr ;

# Postfix chaining with highest binding power:
#   - member access:   a.b.c
#   - indexing:        a[i,j] or a[i][j]; slices use a[start:stop:step]
#   - calls (curly):   f{args}
PostfixExpr    ::= Primary { FieldSuffix | IndexSuffix | CallSuffix } ;

FieldSuffix    ::= DOT IDENT ;
IndexSuffix    ::= LBRACKET ( IndexList | Slice ) RBRACKET ;
IndexList      ::= Expression { COMMA Expression } [ COMMA ] ;
Slice          ::= [ Expression ] COLON [ Expression ] [ COLON [ Expression ] ] ;
# Comma selectors are sequential nested access. Slices cannot share a comma list.
# An omitted bound differs from explicit none, whose numeric value is zero.
CallSuffix     ::= LBRACE [ CallArgList ] RBRACE ;
CallArgList    ::= CallArgument { COMMA CallArgument } [ COMMA ] ;
CallArgument   ::= [ ArgumentLabel ASSIGN ] Expression ;
ArgumentLabel  ::= IDENT | KW_END ;  # contextual print end= option


# Positional arguments precede named arguments. Names label arguments without
# assigning caller variables. Named arguments bind declared user parameters or
# builtin inputs/options from bang/builtin_specs.py. Constructors stay positional-only.

ArgList        ::= Expression { COMMA Expression } [ COMMA ] ;

# Primary atoms
Primary        ::= AnonymousFunction
                 | Literals
                 | IDENT
                 | LBRACKET [ ArgList ] RBRACKET     # Array literal
                 | LPAREN Expression RPAREN ;

Literals       ::= INT_LIT | FLOAT_LIT | BOOL_LIT | NONE_LIT | STRING_LIT | FSTRING_LIT ;

# ---------------------------------------------------------------------
# 5) Precedence & associativity (from the parser)
# ---------------------------------------------------------------------
# Highest → Lowest
#   DOT
#   **        (right-assoc)
#   *, /, //  (left-assoc)
#   +, -      (left-assoc)
#   <, <=, >, >= (left-assoc)
#   ==, !=, in    (left-assoc)
#   &&        (left-assoc)
#   ||        (left-assoc)
# Unary +, -, ! bind tighter than all binary ops.


# Runtime contract and resource limits are specified in LANGUAGE_SEMANTICS.md.
# Numeric literals use ASCII digits. Strings cannot contain raw newlines.
# Each if/elif/else chain has one final end. Each nested block has its own end.
# Each if has at most one else, and no elif may follow it.

# Builtin signatures and option constraints are runtime interfaces, not keywords.
# sum/set accept one iterable input (set also permits an empty constructor).
# enumerate/zip/items/array produce eager arrays; any/all short-circuit callbacks.
# read/write operate on whole UTF-8 files; options are declared in builtin_specs.py.
# Builtins are fallback bindings outside user scopes, never assignment targets.
# Assignments update captured user bindings or create a current-scope binding.
